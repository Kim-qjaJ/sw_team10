# LLM Provider: ollama | groq
LLM_PROVIDER=groq

# Local Ollama (LLM_PROVIDER=ollama 로 바꿀 때만 필요)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=30m
OLLAMA_STRUCTURED_OUTPUT=true

# GroqCloud
# 기본 LLM. https://console.groq.com 에서 키 발급
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_STRUCTURED_OUTPUT=true

# 샘플 장소 데이터 사용 (Provider 구현 후 실제 API 테스트 시 false)
USE_MOCK_PLACES=true
PROVIDER_TIMEOUT_SECONDS=5
# 주변 시설 찾기: 현재 위치가 부산 밖이면 기준 장소를 묻는다 (부산 밖에서 테스트할 때 false)
NEARBY_BUSAN_ONLY=true

# Kakao Local REST API
KAKAO_REST_API_KEY=

# Naver Search Local API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 하루 25000회 이상 검색 시 비용 청구됨

# 공공데이터포털 일반 인증키 1개
# 부산 문화 전시 장소 API, TourAPI, 기상청 API가 같은 키를 공통으로 사용한다.
# Encoding/Decoding 키 어느 쪽을 넣어도 동작하도록 처리한다.
PUBLIC_DATA_API_KEY=

# 각 서비스의 실제 요청 Endpoint
# TourAPI 4.0 (KorService2) 서비스 주소. 관광/문화/놀거리 요청에서 위치기반·키워드 검색에 사용
TOUR_API_URL=https://apis.data.go.kr/B551011/KorService2
# 기상청 단기예보 '초단기실황' 주소. 추천 점수의 날씨(비·기온) 항목에 사용
KMA_API_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst

# 응답 시간 상한 (SRS NFR-001)
# 요청 전체(LLM 해석·결과 요약 포함) 제한 시간과, LLM 해석을 기다리는 최대 시간(초)
REQUEST_TIMEOUT_SECONDS=30
LLM_INTENT_TIMEOUT_SECONDS=20

# Supabase 질의 로그 (선택, SRS NFR-003·DATA-09 잠정안)
# Supabase 대시보드 SQL Editor에서 db/supabase_schema.sql을 먼저 실행한다.
# SUPABASE_SECRET_KEY는 서버 전용 secret 키(sb_secret_...) 또는 예전 service_role 키. 절대 커밋·공유하지 않는다.
# 질의 문장과 처리 경로만 저장하고 세션 ID·좌표는 저장하지 않는다.
QUERY_LOG_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_SECONDS=3
