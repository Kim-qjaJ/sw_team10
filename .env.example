# LLM Provider: ollama | groq 다른거 있으면 다른거 넣어도 됩니다. 기본값 groq
LLM_PROVIDER=groq

# Local Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=30m
OLLAMA_STRUCTURED_OUTPUT=true

# GroqCloud
# LLM_PROVIDER=groq 로 바꿀 때만 필요
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_STRUCTURED_OUTPUT=true

# 실제 API 테스트 시 false
USE_MOCK_PLACES=false
PROVIDER_TIMEOUT_SECONDS=5

# Kakao Local REST API
KAKAO_REST_API_KEY=

# Naver Search Local API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 일반 인증키 1개
# 부산 전시공간 API, TourAPI, 기상청 API가 같은 키를 공통으로 사용한다.
# Encoding/Decoding 키 어느 쪽을 넣어도 동작하도록 처리한다.
PUBLIC_DATA_API_KEY=

# 각 서비스의 실제 요청 Endpoint
TOUR_API_URL=
KMA_API_URL=
